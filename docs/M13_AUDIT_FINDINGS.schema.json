{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sar:m13-audit-findings:schema:1",
  "title": "SAR M13 audit findings registry",
  "description": "Strict machine-readable registry for SAR M13 audit findings, specification gaps, observations, resolutions, and remediation tracking.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "milestone",
    "description",
    "registry_status",
    "source",
    "audit_scopes",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "urn:sar:m13-audit-findings:schema:1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "const": "SAR"
    },
    "milestone": {
      "type": "string",
      "const": "M13"
    },
    "description": {
      "$ref": "#/$defs/non_empty_string"
    },
    "registry_status": {
      "$ref": "#/$defs/registry_status"
    },
    "source": {
      "$ref": "#/$defs/registry_source"
    },
    "generated_markdown": {
      "type": "string",
      "pattern": "^docs/M13_AUDIT_FINDINGS\\.md$"
    },
    "audit_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/audit_scope"
      }
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "metadata": {
      "$ref": "#/$defs/registry_metadata"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^M13-(?:PARSER|CRYPTO|TRANSFORM|EXTRACT|BOUNDARY|COLD|SPEC)-[0-9]{3}$"
    },
    "milestone_id": {
      "type": "string",
      "pattern": "^M13(?:a\\.[1-7]|b\\.[1-4])$"
    },
    "audit_milestone_id": {
      "type": "string",
      "pattern": "^M13a\\.[1-7]$"
    },
    "registry_status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "complete",
        "archived"
      ]
    },
    "registry_source": {
      "type": "string",
      "enum": [
        "manual audit",
        "AI-assisted audit",
        "mixed audit",
        "migrated from markdown"
      ]
    },
    "scope_status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "complete",
        "deferred"
      ]
    },
    "finding_type": {
      "type": "string",
      "enum": [
        "implementation_defect",
        "specification_gap",
        "implementation_spec_mismatch",
        "resource_risk",
        "fuzzing_gap",
        "test_gap",
        "documentation_gap",
        "positive_observation",
        "accepted_design_risk"
      ]
    },
    "finding_area": {
      "type": "string",
      "enum": [
        "parser",
        "memory",
        "panic",
        "dos",
        "resource_limits",
        "unsafe",
        "wire_format",
        "interoperability",
        "cryptography",
        "secret_handling",
        "transform",
        "recovery",
        "filesystem",
        "extraction",
        "crate_boundary",
        "profile_boundary",
        "transport",
        "ffi_readiness",
        "cold_storage",
        "tape",
        "fuzzing",
        "testing",
        "documentation",
        "api",
        "compatibility"
      ]
    },
    "finding_status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "open",
        "pending_normative_resolution",
        "blocked",
        "accepted_risk",
        "verified",
        "remediation_in_progress",
        "resolved",
        "closed_no_action",
        "superseded"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "high",
        "medium",
        "low",
        "informational",
        "not_applicable"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "deferred"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "high",
        "medium",
        "low"
      ]
    },
    "compatibility_impact": {
      "type": "string",
      "enum": [
        "none",
        "documentation_only",
        "behavior_clarification",
        "backward_compatible",
        "potentially_breaking",
        "wire_incompatible",
        "unknown_pending_resolution"
      ]
    },
    "evidence_kind": {
      "type": "string",
      "enum": [
        "source_code",
        "specification",
        "documentation",
        "test",
        "fuzz_target",
        "fuzz_campaign",
        "conformance_vector",
        "command_output",
        "manual_reproduction"
      ]
    },
    "resolution_decision_type": {
      "type": "string",
      "enum": [
        "implementation_change",
        "specification_change",
        "documentation_change",
        "test_or_fuzz_change",
        "accepted_risk",
        "closed_no_action",
        "superseded"
      ]
    },
    "regression_test_requirement": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "pending_normative_resolution"
      ]
    },
    "resolution_owner": {
      "type": "string",
      "enum": [
        "M13a.7",
        "M13b.1",
        "M13b.2",
        "M13b.3",
        "M13b.4",
        "none",
        "pending_triage"
      ]
    },
    "audit_scope": {
      "type": "object",
      "required": [
        "milestone",
        "title",
        "status",
        "included_artifacts",
        "excluded_topics"
      ],
      "additionalProperties": false,
      "properties": {
        "milestone": {
          "$ref": "#/$defs/audit_milestone_id"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "$ref": "#/$defs/scope_status"
        },
        "included_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_path"
          }
        },
        "excluded_topics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        },
        "completed_date": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "completed_date"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "artifact",
        "locator",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/evidence_kind"
        },
        "artifact": {
          "$ref": "#/$defs/artifact_path"
        },
        "locator": {
          "$ref": "#/$defs/non_empty_string"
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "normative_reference": {
      "type": "object",
      "required": [
        "document",
        "locator",
        "requirement"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/artifact_path"
        },
        "locator": {
          "$ref": "#/$defs/non_empty_string"
        },
        "requirement": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "regression_test": {
      "type": "object",
      "required": [
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/regression_test_requirement"
        },
        "scope": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_milestone": {
          "$ref": "#/$defs/milestone_id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": "yes"
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "required": [
              "scope",
              "owner_milestone"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "required": {
                "const": "pending_normative_resolution"
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "not": {
              "required": [
                "owner_milestone"
              ]
            }
          }
        }
      ]
    },
    "remediation": {
      "type": "object",
      "required": [
        "owner",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "$ref": "#/$defs/resolution_owner"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        }
      }
    },
    "resolution": {
      "type": "object",
      "required": [
        "decision_type",
        "milestone",
        "summary",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_type": {
          "$ref": "#/$defs/resolution_decision_type"
        },
        "milestone": {
          "$ref": "#/$defs/milestone_id"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_path"
          }
        },
        "resolved_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "finding_id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/finding_id"
      },
      "default": []
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "$ref": "#/$defs/finding_id_array"
        },
        "blocked_by": {
          "$ref": "#/$defs/finding_id_array"
        },
        "related_findings": {
          "$ref": "#/$defs/finding_id_array"
        },
        "duplicates": {
          "$ref": "#/$defs/finding_id_array"
        },
        "supersedes": {
          "$ref": "#/$defs/finding_id_array"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "finding_type",
        "source_milestone",
        "areas",
        "status",
        "severity",
        "priority",
        "confidence",
        "summary",
        "affected_artifacts",
        "evidence",
        "compatibility_impact",
        "resolution_owner",
        "regression_test"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/finding_id"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "finding_type": {
          "$ref": "#/$defs/finding_type"
        },
        "source_milestone": {
          "$ref": "#/$defs/audit_milestone_id"
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/finding_area"
          }
        },
        "status": {
          "$ref": "#/$defs/finding_status"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "current_behavior": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expected_behavior": {
          "$ref": "#/$defs/non_empty_string"
        },
        "normative_question": {
          "$ref": "#/$defs/non_empty_string"
        },
        "impact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "affected_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_path"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "normative_basis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normative_reference"
          },
          "default": []
        },
        "compatibility_impact": {
          "$ref": "#/$defs/compatibility_impact"
        },
        "resolution_owner": {
          "$ref": "#/$defs/resolution_owner"
        },
        "regression_test": {
          "$ref": "#/$defs/regression_test"
        },
        "remediation": {
          "$ref": "#/$defs/remediation"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        },
        "relationships": {
          "$ref": "#/$defs/relationships"
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "finding_type": {
                "const": "specification_gap"
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "current_behavior",
              "normative_question"
            ],
            "properties": {
              "severity": {
                "const": "not_applicable"
              },
              "status": {
                "enum": [
                  "draft",
                  "confirmed",
                  "pending_normative_resolution",
                  "blocked",
                  "resolved",
                  "superseded"
                ]
              },
              "resolution_owner": {
                "const": "M13a.7"
              },
              "compatibility_impact": {
                "enum": [
                  "behavior_clarification",
                  "potentially_breaking",
                  "wire_incompatible",
                  "unknown_pending_resolution"
                ]
              }
            },
            "not": {
              "required": [
                "remediation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "enum": [
                  "implementation_defect",
                  "implementation_spec_mismatch"
                ]
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "current_behavior",
              "expected_behavior",
              "impact",
              "normative_basis",
              "remediation"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "blocker",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "resolution_owner": {
                "enum": [
                  "M13b.1",
                  "M13b.2",
                  "M13b.3",
                  "M13b.4"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "const": "positive_observation"
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "informational"
              },
              "status": {
                "enum": [
                  "verified",
                  "closed_no_action"
                ]
              },
              "priority": {
                "enum": [
                  "low",
                  "deferred"
                ]
              },
              "resolution_owner": {
                "const": "none"
              },
              "regression_test": {
                "properties": {
                  "required": {
                    "const": "no"
                  }
                },
                "required": [
                  "required"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "remediation"
                  ]
                },
                {
                  "required": [
                    "normative_question"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "enum": [
                  "fuzzing_gap",
                  "test_gap",
                  "documentation_gap"
                ]
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "impact",
              "remediation"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "low",
                  "informational"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "resolution"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "superseded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "relationships"
            ]
          }
        }
      ]
    },
    "registry_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        }
      }
    }
  }
}
