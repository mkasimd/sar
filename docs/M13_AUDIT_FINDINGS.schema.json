{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sar:m13-audit-findings:schema:2",
  "title": "SAR M13 audit findings registry",
  "description": "Strict machine-readable registry for SAR M13 audit findings, specification gaps, observations, decisions, remediation tracking, and closure evidence.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "project",
    "milestone",
    "description",
    "registry_status",
    "source",
    "generated_markdown",
    "audit_scopes",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "urn:sar:m13-audit-findings:schema:2"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "project": {
      "type": "string",
      "const": "SAR"
    },
    "milestone": {
      "type": "string",
      "const": "M13"
    },
    "description": {
      "$ref": "#/$defs/non_empty_string"
    },
    "registry_status": {
      "$ref": "#/$defs/registry_status"
    },
    "source": {
      "$ref": "#/$defs/registry_source"
    },
    "generated_markdown": {
      "type": "string",
      "const": "docs/M13_AUDIT_FINDINGS.md"
    },
    "audit_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/audit_scope"
      }
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "metadata": {
      "$ref": "#/$defs/registry_metadata"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^M13-(?:PARSER|CRYPTO|TRANSFORM|RECOVERY|EXTRACT|BOUNDARY|TRANSPORT|FFI|COLD|SPEC)-[0-9]{3}$"
    },
    "milestone_id": {
      "type": "string",
      "pattern": "^M13(?:a\\.[1-7]|b\\.[1-4])$"
    },
    "audit_milestone_id": {
      "type": "string",
      "pattern": "^M13a\\.[1-7]$"
    },
    "registry_status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "complete",
        "archived"
      ]
    },
    "registry_source": {
      "type": "string",
      "enum": [
        "manual audit",
        "AI-assisted audit",
        "mixed audit",
        "migrated from markdown"
      ]
    },
    "scope_status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "complete",
        "deferred",
        "cancelled"
      ]
    },
    "finding_type": {
      "type": "string",
      "enum": [
        "implementation_defect",
        "specification_gap",
        "implementation_spec_mismatch",
        "resource_risk",
        "fuzzing_gap",
        "test_gap",
        "documentation_gap",
        "positive_observation",
        "accepted_design_risk"
      ]
    },
    "finding_area": {
      "type": "string",
      "enum": [
        "parser",
        "memory",
        "panic",
        "dos",
        "resource_limits",
        "unsafe",
        "wire_format",
        "interoperability",
        "cryptography",
        "authentication",
        "secret_handling",
        "transform",
        "compression",
        "delta",
        "sparse",
        "fec",
        "recovery",
        "filesystem",
        "metadata_restoration",
        "path_handling",
        "symlink",
        "hardlink",
        "extraction",
        "crate_boundary",
        "profile_boundary",
        "transport",
        "session",
        "ffi_readiness",
        "public_api",
        "cold_storage",
        "tape",
        "fuzzing",
        "testing",
        "documentation",
        "compatibility",
        "conformance",
        "logging",
        "error_handling"
      ]
    },
    "finding_status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "open",
        "pending_normative_resolution",
        "blocked",
        "accepted_risk",
        "verified",
        "remediation_in_progress",
        "resolved",
        "closed_no_action",
        "superseded"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "high",
        "medium",
        "low",
        "informational",
        "not_applicable"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "deferred"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "high",
        "medium",
        "low"
      ]
    },
    "compatibility_impact": {
      "type": "string",
      "enum": [
        "none",
        "documentation_only",
        "clarification_only",
        "preserves_compliant_inputs",
        "rejects_previously_accepted_nonconforming_input",
        "source_compatible",
        "source_breaking",
        "behavioral_change",
        "wire_incompatible",
        "unknown_pending_resolution"
      ]
    },
    "evidence_kind": {
      "type": "string",
      "enum": [
        "source_code",
        "specification",
        "documentation",
        "test",
        "fuzz_target",
        "fuzz_campaign",
        "conformance_vector",
        "command_output",
        "manual_reproduction"
      ]
    },
    "resolution_decision_type": {
      "type": "string",
      "enum": [
        "implementation_change",
        "specification_change",
        "documentation_change",
        "test_change",
        "fuzzing_change",
        "accepted_risk",
        "verified_control",
        "closed_no_action",
        "superseded"
      ]
    },
    "resolution_owner": {
      "type": "string",
      "enum": [
        "M13a.1",
        "M13a.2",
        "M13a.3",
        "M13a.4",
        "M13a.5",
        "M13a.6",
        "M13a.7",
        "M13b.1",
        "M13b.2",
        "M13b.3",
        "M13b.4",
        "none",
        "pending_triage"
      ]
    },
    "audit_scope": {
      "type": "object",
      "required": [
        "milestone",
        "title",
        "status",
        "included_artifacts",
        "excluded_topics",
        "objectives"
      ],
      "additionalProperties": false,
      "properties": {
        "milestone": {
          "$ref": "#/$defs/audit_milestone_id"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "$ref": "#/$defs/scope_status"
        },
        "included_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_path"
          }
        },
        "excluded_topics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        },
        "completed_date": {
          "$ref": "#/$defs/iso_date"
        },
        "started_date": {
          "$ref": "#/$defs/iso_date"
        },
        "reviewed_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/audit_objective"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "completed_date",
              "reviewed_commit"
            ],
            "properties": {
              "objectives": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "complete",
                        "not_applicable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "artifact",
        "locator",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/evidence_kind"
        },
        "artifact": {
          "$ref": "#/$defs/artifact_path"
        },
        "locator": {
          "$ref": "#/$defs/non_empty_string"
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "reproduction": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "normative_reference": {
      "type": "object",
      "required": [
        "document",
        "locator",
        "requirement"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/artifact_path"
        },
        "locator": {
          "$ref": "#/$defs/non_empty_string"
        },
        "requirement": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "remediation": {
      "type": "object",
      "required": [
        "owner",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "$ref": "#/$defs/resolution_owner"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        }
      }
    },
    "resolution": {
      "type": "object",
      "required": [
        "decision_type",
        "milestone",
        "summary",
        "resolved_date"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_type": {
          "$ref": "#/$defs/resolution_decision_type"
        },
        "milestone": {
          "$ref": "#/$defs/milestone_id"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_path"
          },
          "uniqueItems": true
        },
        "resolved_date": {
          "$ref": "#/$defs/iso_date"
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision_type": {
                "enum": [
                  "documentation_change",
                  "fuzzing_change",
                  "implementation_change",
                  "specification_change",
                  "test_change"
                ]
              }
            },
            "required": [
              "decision_type"
            ]
          },
          "then": {
            "required": [
              "references"
            ],
            "properties": {
              "references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "finding_id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/finding_id"
      },
      "default": []
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "$ref": "#/$defs/finding_id_array"
        },
        "blocked_by": {
          "$ref": "#/$defs/finding_id_array"
        },
        "related_findings": {
          "$ref": "#/$defs/finding_id_array"
        },
        "duplicates": {
          "$ref": "#/$defs/finding_id_array"
        },
        "supersedes": {
          "$ref": "#/$defs/finding_id_array"
        },
        "superseded_by": {
          "$ref": "#/$defs/finding_id_array"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "finding_type",
        "source_milestone",
        "areas",
        "status",
        "severity",
        "priority",
        "confidence",
        "summary",
        "affected_artifacts",
        "evidence",
        "compatibility_impact",
        "resolution_owner",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/finding_id"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "finding_type": {
          "$ref": "#/$defs/finding_type"
        },
        "source_milestone": {
          "$ref": "#/$defs/audit_milestone_id"
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/finding_area"
          }
        },
        "status": {
          "$ref": "#/$defs/finding_status"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "current_behavior": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expected_behavior": {
          "$ref": "#/$defs/non_empty_string"
        },
        "normative_question": {
          "$ref": "#/$defs/non_empty_string"
        },
        "impact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "affected_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_path"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "normative_basis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normative_reference"
          },
          "default": []
        },
        "compatibility_impact": {
          "$ref": "#/$defs/compatibility_impact"
        },
        "resolution_owner": {
          "$ref": "#/$defs/resolution_owner"
        },
        "remediation": {
          "$ref": "#/$defs/remediation"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        },
        "relationships": {
          "$ref": "#/$defs/relationships"
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "risk_acceptance_rationale": {
          "$ref": "#/$defs/non_empty_string"
        },
        "risk_acceptance_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "finding_type": {
                "const": "specification_gap"
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "current_behavior",
              "normative_question"
            ],
            "properties": {
              "severity": {
                "const": "not_applicable"
              },
              "status": {
                "enum": [
                  "draft",
                  "confirmed",
                  "pending_normative_resolution",
                  "blocked",
                  "resolved",
                  "superseded"
                ]
              },
              "resolution_owner": {
                "const": "M13a.7"
              },
              "compatibility_impact": {
                "enum": [
                  "clarification_only",
                  "behavioral_change",
                  "wire_incompatible",
                  "unknown_pending_resolution"
                ]
              }
            },
            "not": {
              "required": [
                "remediation"
              ]
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "draft",
                        "confirmed",
                        "pending_normative_resolution",
                        "blocked"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "verification": {
                      "properties": {
                        "test_requirement": {
                          "const": "pending_normative_resolution"
                        }
                      },
                      "required": [
                        "test_requirement"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "resolved",
                        "superseded"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "verification": {
                      "properties": {
                        "test_requirement": {
                          "const": "not_required"
                        }
                      },
                      "required": [
                        "test_requirement"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "const": "implementation_spec_mismatch"
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "current_behavior",
              "expected_behavior",
              "impact",
              "normative_basis"
            ],
            "properties": {
              "normative_basis": {
                "minItems": 1
              },
              "severity": {
                "enum": [
                  "blocker",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "resolution_owner": {
                "enum": [
                  "M13b.1",
                  "M13b.2",
                  "M13b.3",
                  "M13b.4",
                  "pending_triage"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "const": "implementation_defect"
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "current_behavior",
              "expected_behavior",
              "impact"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "blocker",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "resolution_owner": {
                "enum": [
                  "M13b.1",
                  "M13b.2",
                  "M13b.3",
                  "M13b.4",
                  "pending_triage"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "const": "resource_risk"
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "current_behavior",
              "impact"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "blocker",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "resolution_owner": {
                "enum": [
                  "M13b.1",
                  "M13b.2",
                  "M13b.3",
                  "M13b.4",
                  "pending_triage"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "const": "positive_observation"
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "informational"
              },
              "status": {
                "enum": [
                  "verified",
                  "closed_no_action"
                ]
              },
              "priority": {
                "enum": [
                  "low",
                  "deferred"
                ]
              },
              "resolution_owner": {
                "const": "none"
              },
              "verification": {
                "properties": {
                  "test_requirement": {
                    "const": "not_required"
                  }
                },
                "required": [
                  "test_requirement"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "remediation"
                  ]
                },
                {
                  "required": [
                    "normative_question"
                  ]
                },
                {
                  "required": [
                    "risk_acceptance_rationale"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "const": "accepted_design_risk"
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "current_behavior",
              "impact",
              "risk_acceptance_rationale",
              "risk_acceptance_conditions",
              "resolution"
            ],
            "properties": {
              "status": {
                "const": "accepted_risk"
              },
              "severity": {
                "enum": [
                  "blocker",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "resolution_owner": {
                "const": "none"
              },
              "resolution": {
                "properties": {
                  "decision_type": {
                    "const": "accepted_risk"
                  }
                },
                "required": [
                  "decision_type",
                  "milestone",
                  "summary"
                ]
              }
            },
            "not": {
              "required": [
                "remediation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_type": {
                "enum": [
                  "fuzzing_gap",
                  "test_gap",
                  "documentation_gap"
                ]
              }
            },
            "required": [
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "impact"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "low",
                  "informational"
                ]
              },
              "resolution_owner": {
                "enum": [
                  "M13a.1",
                  "M13a.2",
                  "M13a.3",
                  "M13a.4",
                  "M13a.5",
                  "M13a.6",
                  "M13a.7",
                  "M13b.1",
                  "M13b.2",
                  "M13b.3",
                  "M13b.4",
                  "none",
                  "pending_triage"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "open",
                  "confirmed",
                  "blocked",
                  "remediation_in_progress"
                ]
              },
              "finding_type": {
                "enum": [
                  "implementation_defect",
                  "implementation_spec_mismatch",
                  "resource_risk",
                  "fuzzing_gap",
                  "test_gap",
                  "documentation_gap"
                ]
              }
            },
            "required": [
              "status",
              "finding_type"
            ]
          },
          "then": {
            "required": [
              "remediation"
            ],
            "properties": {
              "resolution_owner": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "resolved",
                  "closed_no_action",
                  "accepted_risk",
                  "verified",
                  "superseded"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "resolution"
            ],
            "not": {
              "required": [
                "remediation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "closed_no_action"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "resolution_owner": {
                "const": "none"
              },
              "resolution": {
                "properties": {
                  "decision_type": {
                    "const": "closed_no_action"
                  }
                },
                "required": [
                  "decision_type",
                  "milestone",
                  "summary"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "resolution_owner": {
                "const": "none"
              },
              "resolution": {
                "properties": {
                  "decision_type": {
                    "const": "verified_control"
                  }
                },
                "required": [
                  "decision_type",
                  "milestone",
                  "summary"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "superseded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "relationships"
            ],
            "properties": {
              "resolution": {
                "properties": {
                  "decision_type": {
                    "const": "superseded"
                  }
                },
                "required": [
                  "decision_type",
                  "milestone",
                  "summary"
                ]
              },
              "relationships": {
                "required": [
                  "superseded_by"
                ],
                "properties": {
                  "superseded_by": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "registry_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_updated": {
          "$ref": "#/$defs/iso_date"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "test_requirement": {
      "type": "string",
      "enum": [
        "required",
        "not_required",
        "pending_normative_resolution"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "test_requirement"
      ],
      "additionalProperties": false,
      "properties": {
        "test_requirement": {
          "$ref": "#/$defs/test_requirement"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "owner_milestone": {
          "$ref": "#/$defs/milestone_id"
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_path"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "test_requirement": {
                "const": "required"
              }
            },
            "required": [
              "test_requirement"
            ]
          },
          "then": {
            "required": [
              "acceptance_criteria",
              "owner_milestone"
            ],
            "properties": {
              "acceptance_criteria": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_requirement": {
                "const": "not_required"
              }
            },
            "required": [
              "test_requirement"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "acceptance_criteria"
                  ]
                },
                {
                  "required": [
                    "owner_milestone"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_requirement": {
                "const": "pending_normative_resolution"
              }
            },
            "required": [
              "test_requirement"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "acceptance_criteria"
                  ]
                },
                {
                  "required": [
                    "owner_milestone"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "audit_objective_status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "complete",
        "deferred",
        "not_applicable",
        "cancelled"
      ]
    },
    "audit_objective_outcome": {
      "type": "string",
      "enum": [
        "not_assessed",
        "no_findings",
        "findings_recorded",
        "observations_only",
        "mixed",
        "not_applicable"
      ]
    },
    "audit_objective": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "outcome",
        "summary",
        "related_findings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M13a\\.[1-7]-OBJ-[0-9]{2}$"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "$ref": "#/$defs/audit_objective_status"
        },
        "outcome": {
          "$ref": "#/$defs/audit_objective_outcome"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "related_findings": {
          "$ref": "#/$defs/finding_id_array"
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "default": []
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "planned"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not_assessed"
              },
              "related_findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "in_progress"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "not_assessed",
                  "findings_recorded",
                  "observations_only",
                  "mixed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "no_findings",
                  "findings_recorded",
                  "observations_only",
                  "mixed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "deferred"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not_assessed"
              },
              "related_findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "cancelled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not_assessed"
              },
              "related_findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not_applicable"
              },
              "related_findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "findings_recorded",
                  "observations_only",
                  "mixed"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "related_findings": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "not_assessed",
                  "no_findings",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "related_findings": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "iso_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    }
  }
}
